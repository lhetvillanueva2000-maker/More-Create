                "has_gravity": false
            },
            "minecraft:persistent": {},
            "minecraft:type_family": {
                "family": [
                    "inanimate",
                    "morecreate_cannon"
                ]
            }
        },
        "events": {
            "davi:despawn": {
                "add": {
                    "component_groups": [
                        "davi:remover"
                    ]
                }
            }
        }
